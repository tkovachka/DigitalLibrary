@model LibraryApplication.Domain.Domain.Author

@{
    ViewData["Title"] = "Author Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <p class="section-eyebrow mb-1">Author</p>
        <h1 class="mb-0">@Model.Name</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Authors</a>
</div>

<div class="mb-4"></div>

<div class="folio-card">
    @if (!Model.Books.Any())
    {
        <div class="empty-state">
            <span class="empty-state-icon">📚</span>
            <h3>No books found for this author</h3>
        </div>
    }
    else
    {
        <table class="table-folio">
            <thead>
                <tr>
                    <th>Cover</th>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Availability</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(book.ThumbnailUrl))
                            {
                                <img src="@book.ThumbnailUrl" alt="@book.Title" class="book-thumb" />
                            }
                            else
                            {
                                <div style="width:50px;height:70px;background:linear-gradient(160deg,var(--burgundy-dark),var(--burgundy-mid));border-radius:2px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.2);font-size:1.3rem;">📖</div>
                            }
                        </td>
                        <td>
                            <span style="font-family:'Cormorant Garamond',serif;font-weight:600;color:var(--burgundy-dark);">@book.Title</span>
                        </td>
                        <td style="color:var(--text-muted);font-size:0.85rem;">@book.PublishedDate</td>
                        <td>
                            @if (book.IsAvailable)
                            {
                                <span class="book-detail-availability availability-yes" style="font-size:0.7rem;padding:0.2rem 0.6rem;">Available</span>
                            }
                            else
                            {
                                <span class="book-detail-availability availability-no" style="font-size:0.7rem;padding:0.2rem 0.6rem;">On Loan</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-controller="Books" asp-route-id="@book.Id" class="btn btn-primary btn-sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>